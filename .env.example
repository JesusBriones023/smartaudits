DB_URL=jdbc:mariadb://localhost:3306/smartaudits_db
DB_USERNAME=smartaudits_user
DB_PASSWORD=
DB_ROOT_PASSWORD=
JWT_SECRET=
SMARTAUDITS_ADMIN_EMAIL=
SMARTAUDITS_ADMIN_PASSWORD=
SMARTAUDITS_ADMIN_NOMBRE=Administrador
APP_ADMIN_BOOTSTRAP_ENABLED=false
APP_DATA_INITIALIZER_ENABLED=true
# Existing database: validate only. Provision a new schema separately.
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
JWT_ISSUER=smartaudits
JWT_AUDIENCE=smartaudits-api
AUDIT_DAILY_LIMIT=100
# Flyway remains disabled by default and must be enabled explicitly.
FLYWAY_ENABLED=false
# Historical baseline adoption is disabled by default.
# Use only the controlled -AdoptLegacySchema procedure for an approved legacy schema.
FLYWAY_BASELINE_ON_MIGRATE=false